<Window x:Class="ImpulsumLauncher14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIFA 14 Launcher"
        Width="810" Height="655"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" Margin="0,0,9,0">
                                <Ellipse x:Name="Outer" Stroke="{StaticResource BorderBrush2}" StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse x:Name="Inner" Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Inner" Property="Opacity" Value="1"/>
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="18" Height="18" Margin="0,0,9,0" CornerRadius="5"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1.5" Background="Transparent">
                                <Path x:Name="Check" Data="M3,8.5 L7,12.5 L14,4" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                            <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextTertiaryBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="8,0,2,0"/>
                            </Grid>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource TitleBarBgBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="4"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource BorderBrush2}" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                Background="{StaticResource TitleBarBgBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Impulsum Launcher 14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeBtn_Click"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainContent" Grid.Row="1" Margin="48,32,48,32">

                <Grid x:Name="SetupScreen" Visibility="Visible">
                    <Border Style="{StaticResource Card}" Width="440" Height="232"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Set up FIFA 14" Style="{StaticResource CardHeader}" FontSize="20"/>
                            <TextBlock Text="Select the folder that contains fifa14.exe to get started."
                                   Style="{StaticResource CardDescription}"
                                   Margin="0,6,0,20"/>

                            <Grid Margin="0,0,0,16">
                                <TextBox x:Name="GamePathBox"
                                     Style="{StaticResource TextField}"
                                     TextChanged="GamePathBox_TextChanged"/>
                                <TextBlock x:Name="PlaceholderText"
                                       Text=" Select your FIFA 14 folder…"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="14" Margin="14,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Auto Detect"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="DetectGameBtn_Click"/>

                                <Button Grid.Column="2" Content="Browse…"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BrowseGamePath_Click"/>

                                <Button Grid.Column="4" x:Name="ContinueBtn" Content="Continue"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="False" Click="ContinueBtn_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PlayScreen" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">

                        <Border x:Name="BannerBorder" Height="270"
                            CornerRadius="14" Margin="0,0,0,28">
                            <Grid>
                                <Image Source="Resources/banner.jpg"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.4"/>
                                            <GradientStop Color="#B0000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="FIFA 14" Foreground="White"
                                       FontSize="28" FontWeight="Bold"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                       Margin="24,0,0,20"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="·"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="14" Margin="8,0" VerticalAlignment="Center"/>
                                <Button x:Name="ChangePathBtn" Content="Change Path"
                                    Click="ChangePathBtn_Click"
                                    Cursor="Hand"
                                    Foreground="{StaticResource AccentBrush}"
                                    FontSize="14">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="16" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ServerStatusDot"
                                         Width="8" Height="8"
                                         Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ServerStatusText"
                                           Text="Ready"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="PlayBtn" Content="Play"
                                Style="{StaticResource PrimaryButton}"
                                Click="PlayBtn_Click"
                                Height="56" FontSize="16"/>

                            <Button Grid.Column="2" Style="{StaticResource SettingsButton}"
                                Width="56" Height="56" Click="SettingsBtn_Click">
                                <Viewbox Width="22" Height="22" Stretch="Uniform">
                                    <Path Data="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94l-0.36,-2.54c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41l-0.36,2.54c-0.59,0.24 -1.13,0.57 -1.62,0.94l-2.39,-0.96c-0.22,-0.08 -0.47,0 -0.59,0.22l-1.92,3.32c-0.12,0.22 -0.07,0.47 0.12,0.61l2.03,1.58c-0.05,0.3 -0.07,0.62 -0.07,0.94s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61l-2.03,-1.58zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6s-1.62,3.6 -3.6,3.6z"
                                      Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="24" Height="24"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

            </Grid>

            <TextBlock Text="Made by Marvelco"
                   Grid.Row="1"
                   Foreground="{StaticResource TextTertiaryBrush}"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,10"
                   IsHitTestVisible="False"/>

            <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Panel.ZIndex="100" Grid.Row="1">

                <Rectangle x:Name="SettingsDim" Fill="#000000" Opacity="0"/>

                <Border Style="{StaticResource Card}" Width="440" Height="520" Padding="28,24,28,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="SettingsCardScale" CenterX="0.5" CenterY="0.5"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Settings" Style="{StaticResource CardHeader}" FontSize="20" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Button x:Name="ProfileTabBtn" Content="FUT Profile"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ProfileTabBtn_Click" Margin="0,0,8,0"/>
                                <Button x:Name="DisplayTabBtn" Content="Game Settings"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="DisplayTabBtn_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
                            <StackPanel>

                                <StackPanel x:Name="ProfileTabPanel" Visibility="Visible">
                                    <TextBlock Text="Username" Style="{StaticResource CardDescription}" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBox x:Name="SettingsUsernameBox" Style="{StaticResource TextField}" Height="48"/>

                                    <TextBlock Text="Coin balance" Style="{StaticResource CardDescription}" FontSize="14" Margin="0,18,0,8"/>
                                    <TextBox x:Name="SettingsCoinsBox" Style="{StaticResource TextField}" Height="48"
                                         PreviewTextInput="SettingsCoinsBox_PreviewTextInput"
                                         TextChanged="SettingsCoinsBox_TextChanged"
                                         GotFocus="SettingsCoinsBox_GotFocus"/>
                                </StackPanel>

                                <StackPanel x:Name="DisplayTabPanel" Visibility="Collapsed">

                                    <TextBlock Text="Resolution" Style="{StaticResource CardDescription}" FontSize="14" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="ResolutionCombo" Height="40"/>

                                    <TextBlock Text="Screen Mode" Style="{StaticResource CardDescription}" FontSize="14" Margin="0,18,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FullscreenRadio" Content="Fullscreen" GroupName="DisplayMode" Margin="0,0,20,0"/>
                                        <RadioButton x:Name="WindowedRadio" Content="Windowed" GroupName="DisplayMode"/>
                                    </StackPanel>

                                    <TextBlock Text="Rendering Quality" Style="{StaticResource CardDescription}" FontSize="14" Margin="0,18,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <RadioButton Grid.Row="0" Grid.Column="0" x:Name="QualitySuperLowRadio" Content="Super Low"
                                                 GroupName="Quality" Margin="0,0,0,10" Checked="QualityRadio_Checked"/>
                                        <RadioButton Grid.Row="0" Grid.Column="1" x:Name="QualityLowRadio" Content="Low"
                                                 GroupName="Quality" Margin="0,0,0,10" Checked="QualityRadio_Checked"/>
                                        <RadioButton Grid.Row="1" Grid.Column="0" x:Name="QualityMediumRadio" Content="Medium"
                                                 GroupName="Quality" Checked="QualityRadio_Checked"/>
                                        <RadioButton Grid.Row="1" Grid.Column="1" x:Name="QualityHighRadio" Content="High"
                                                 GroupName="Quality" Checked="QualityRadio_Checked"/>
                                    </Grid>
                                    <TextBlock x:Name="QualityDescriptionText"
                                           Style="{StaticResource CardDescription}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Wait for Vsync" Style="{StaticResource CardDescription}" FontSize="14" Margin="0,0,0,8"/>
                                            <ComboBox x:Name="VsyncCombo" Height="40">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="On"/>
                                                <ComboBoxItem Content="Default"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Anti-aliasing" Style="{StaticResource CardDescription}" FontSize="14" Margin="0,0,0,8"/>
                                            <ComboBox x:Name="MsaaCombo" Height="40">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="2x"/>
                                                <ComboBoxItem Content="4x"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Button Icons" Style="{StaticResource CardDescription}" FontSize="14" Margin="0,18,0,8"/>
                                    <ComboBox x:Name="ControllerDefaultCombo" Height="40">
                                        <ComboBoxItem Content="Logitech F510 Type"/>
                                        <ComboBoxItem Content="Logitech Rumble Pad 2"/>
                                    </ComboBox>

                                    <StackPanel Margin="0,18,0,4">
                                        <CheckBox x:Name="ScreenSleepCheckBox" Content="Allow screen to sleep" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="DisableAeroCheckBox" Content="Disable Windows Aero" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="VoiceChatCheckBox" Content="Voice Chat"/>
                                    </StackPanel>

                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Restart the game to see the changes."
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" Margin="0,14,0,0"/>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Save" Style="{StaticResource PrimaryButton}"
                                    Height="48" Click="SettingsSaveBtn_Click"/>
                                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}"
                                    Height="48" Click="SettingsCloseBtn_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
