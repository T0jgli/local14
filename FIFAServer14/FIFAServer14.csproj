<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>FIFAServer14</AssemblyName>
    <RootNamespace>FIFAServer14</RootNamespace>
    <ApplicationIcon>Content\FIFAServer14.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SDK\**\*.cs" />
    <EmbeddedResource Remove="SDK\**\*" />
    <None Remove="SDK\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content\FIFAServer14.ico" />
    <Content Include="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="players.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Blaze3SDK = the FIFA-2014 / Blaze 13.3 era SDK (same repo as Blaze15 used for FIFA 16). -->
    <ProjectReference Include="SDK\Blaze.Core\Blaze.Core.csproj" />
    <ProjectReference Include="SDK\Blaze3SDK\Blaze3SDK.csproj" />
    <ProjectReference Include="SDK\ProtoFire\ProtoFire.csproj" />
    <ProjectReference Include="SDK\EATDF\EATDF.csproj" />
  </ItemGroup>

</Project>
